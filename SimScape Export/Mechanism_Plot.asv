%% ===============================
%  Plot Simscape Toe Position
% ===============================

% Requires Simscape Data
plot (out.x, out.z);
title('Position of Toe');
ylabel('z-position (mm)');
xlabel('x-position (mm)');
grid on

%% =====================================
%  Plot Simscape and Matlab Toe Position
% ======================================

% Require Simscape Data and Matlab File Data
plot (out.x, out.z);
hold on
plot(x_toe, y_toe, 'r', 'LineWidth', 2);

title('Position of Toe');
ylabel('z-position (mm)');
xlabel('x-position (mm)');
grid on





